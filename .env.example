DB_NAME=nova_sounds
DB_USER=nova_app
DB_PASSWORD=

# Direccion de la aplicacion: http://localhost:8000
APP_PORT=8000

# Cuenta inicial de la aplicacion (rol Sistemas). Se crea una sola vez al arrancar.
# Completa la contrasena con al menos 8 caracteres antes de ejecutar Compose.
# Los reinicios NO restablecen su contrasena, rol, permisos ni estado.
SISTEMAS_USUARIO=sistemas
SISTEMAS_NOMBRE=Sistemas
SISTEMAS_PASSWORD=