# Uso local SIN Docker. Para Docker, configura el .env de la raiz del proyecto.
# Dentro de Docker, Compose asigna DB_HOST=db y DB_PORT=5432 automaticamente.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nova_sounds
DB_USER=nova_app
DB_PASSWORD=

# Autenticacion de Almacen: permanece deshabilitado el modo sin credenciales.
ALMACEN_DEV_MODE=0

# Cuenta inicial con acceso a Sistemas. No se restablece en cada arranque.
SISTEMAS_USUARIO=sistemas
SISTEMAS_NOMBRE=Sistemas
SISTEMAS_PASSWORD=
